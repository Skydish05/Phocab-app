# Copy to .env and adjust. Only variables the code actually reads are listed.
APP_ENV=development

# Postgres (infra/docker-compose.yml reads POSTGRES_*; the app reads DATABASE_URL)
POSTGRES_USER=phocab
POSTGRES_PASSWORD=phocab
POSTGRES_DB=phocab
DATABASE_URL=postgresql+psycopg://phocab:phocab@localhost:5432/phocab
# Tests use a separate database so they never wipe dev data; created automatically.
TEST_DATABASE_URL=postgresql+psycopg://phocab:phocab@localhost:5432/phocab_test

# Auth. Required, at least 32 chars. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# model_service
MODEL_ID=google/siglip2-base-patch16-224
# Optional; defaults to model_service/labels_ko.csv
# LABELS_PATH=model_service/labels_ko.csv
