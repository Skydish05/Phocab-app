# Copy to .env and adjust. Only variables the code actually reads are listed.
APP_ENV=development

# Postgres (infra/docker-compose.yml reads POSTGRES_*; the app reads DATABASE_URL)
POSTGRES_USER=phocab
POSTGRES_PASSWORD=phocab
POSTGRES_DB=phocab
DATABASE_URL=postgresql+psycopg://phocab:phocab@localhost:5432/phocab
# Tests use a separate database so they never wipe dev data; created automatically.
TEST_DATABASE_URL=postgresql+psycopg://phocab:phocab@localhost:5432/phocab_test

# Auth. Required, at least 32 chars. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# API -> model_service
MODEL_SERVICE_URL=http://localhost:8001
# Optional; defaults to model_service/labels_ko.csv (the same file the model uses)
# VOCAB_PATH=model_service/labels_ko.csv

# Photo storage. Required. AWS credentials are NOT set here: boto3 uses the EC2
# instance role in production and your ~/.aws profile locally.
S3_BUCKET=
AWS_REGION=ap-northeast-2

# Card generation (Google Gemini). Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# model_service
MODEL_ID=google/siglip2-base-patch16-224
# Optional; defaults to model_service/labels_ko.csv
# LABELS_PATH=model_service/labels_ko.csv
